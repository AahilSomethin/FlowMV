# Runtime only. Never put owner/migrator/bootstrap credentials in this file.
APP_NAME=FlowMV
APP_ENV=production
APP_DEBUG=false
APP_URL=https://flowmv.example
FRONTEND_URL=https://flowmv.example
APP_KEY=__INDEPENDENT_APP_KEY_FROM_SECRET_MANAGER__
DB_CONNECTION=pgsql
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=flowmv
DB_USERNAME=flowmv_runtime
DB_PASSWORD=__RUNTIME_ROLE_SECRET__
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/certs/db.crt
SESSION_DRIVER=database
SESSION_COOKIE=flowmv-release
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=flowmv.example
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
OPS_HEARTBEAT_ENABLED=true
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_HOST=__APPROVED_MAIL_HOST__
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=__APPROVED_MAIL_USER__
MAIL_PASSWORD=__APPROVED_MAIL_SECRET__
MAIL_FROM_ADDRESS=__APPROVED_SENDER__
INTEGRATION_ACTIVE_KEY=v1
INTEGRATION_KEYS='{"v1":"__INDEPENDENT_VAULT_KEY_BASE64__"}'
AI_ENABLED=false
AI_SIMULATED=false
AI_SERVICE_URL=https://ai-go:8020
AI_CA_CERT=/certs/ai.crt
AI_SERVICE_KEY=__INDEPENDENT_64_HEX_SERVICE_KEY__
# Providers and document processing remain disabled until their release gates close.
INTEGRATION_MOCK_ENABLED=false
INTEGRATION_TELEGRAM_ENABLED=false
INTEGRATION_TELEGRAM_SIMULATED=false
INTEGRATION_EMAIL_ENABLED=false
INTEGRATION_EMAIL_SIMULATED=false
SLACK_ENABLED=false
SLACK_SIMULATED=false
SMS_ENABLED=false
SMS_SIMULATED=false
